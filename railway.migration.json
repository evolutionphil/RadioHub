    "dockerfilePath": "Dockerfile.migration"
  },
  "deploy": {
    "startCommand": "node dist/bootstrap.mjs",
    "healthcheckPath": null,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
