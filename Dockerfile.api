FROM node:24-slim AS base

RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.19.0 --activate

WORKDIR /app

# ── Step 1: copy only manifests so pnpm install is layer-cached ──────────────
# As long as no dependency changes, this layer is reused across deploys and
# pnpm install is skipped entirely — saves 5-10 minutes per deploy.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY tsconfig.base.json tsconfig.json ./
COPY artifacts/api-server/package.json          ./artifacts/api-server/
COPY artifacts/megaradio/package.json           ./artifacts/megaradio/
COPY lib/db-shared/package.json                 ./lib/db-shared/
COPY lib/legacy-migration/package.json          ./lib/legacy-migration/
COPY lib/seo-shared/package.json                ./lib/seo-shared/
COPY lib/api-client-react/package.json          ./lib/api-client-react/
COPY lib/api-zod/package.json                   ./lib/api-zod/
COPY lib/api-spec/package.json                  ./lib/api-spec/
COPY lib/db/package.json                        ./lib/db/
COPY scripts/package.json                       ./scripts/

RUN pnpm install --frozen-lockfile

# ── Step 2: copy source (invalidates build layers only, not install) ──────────
COPY artifacts ./artifacts
COPY lib ./lib
COPY scripts ./scripts
COPY attached_assets ./attached_assets

# Build admin SPA (for /admin) and the API server bundle
ENV PORT=5000
ENV BASE_PATH=/
ENV VITE_STREAM_PROXY_URL=https://stream.themegaradio.com
RUN pnpm --filter @workspace/megaradio run build
RUN ENTRY=src/index-api.ts pnpm --filter @workspace/api-server run build

# Create a flat, production-only deploy directory with hoisted node_modules
RUN pnpm --filter @workspace/api-server deploy --prod --legacy /deploy
RUN cp -r /app/artifacts/megaradio/dist/public /deploy/dist/public
# Admin translation-key discovery scans the frontend source tree at runtime.
RUN mkdir -p /deploy/artifacts/megaradio && cp -r /app/artifacts/megaradio/src /deploy/artifacts/megaradio/src
RUN mkdir -p /deploy/scripts && cp /app/artifacts/api-server/scripts/apply-postgres-migrations.mjs /deploy/scripts/
RUN cp -r /app/lib/db/migrations /deploy/db-migrations

FROM node:24-slim AS production

RUN apt-get update && apt-get install -y \
    ca-certificates \
    libjemalloc2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=base /deploy ./

ENV NODE_ENV=production
ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2
ENV MALLOC_CONF=background_thread:true,dirty_decay_ms:1000,muzzy_decay_ms:1000

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "const http=require('http');http.get('http://localhost:'+(process.env.PORT||5000)+'/healthz',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1));"

CMD ["node", "--max-old-space-size=4096", "--max-semi-space-size=64", "--expose-gc", "scripts/start-postgres.mjs", "dist/index-api.mjs"]
